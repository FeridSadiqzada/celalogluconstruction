APP_NAME="Cəlaloğlu İnşaat MMC"
APP_ENV=production
APP_KEY=base64:zBaIhf8AsGPeGS23t77CZUnDVPyr9vspNRQCVl0RGy8=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=az
APP_FALLBACK_LOCALE=en

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=celaloglu_insaat
DB_USERNAME=celaloglu_user
DB_PASSWORD=celaloglu_password_123
DB_ROOT_PASSWORD=root_secure_password_123

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=redis_password_123
REDIS_PORT=6379

# Cache & Sessions
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Filament
FILAMENT_DOMAIN=your-domain.com
FILAMENT_PATH=admin