APP_NAME="Cəlaloğlu İnşaat MMC"
APP_ENV=production
APP_KEY=base64:zBaIhf8AsGPeGS23t77CZUnDVPyr9vspNRQCVl0RGy8=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=az
APP_FALLBACK_LOCALE=en

# SQLite Database
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# File-based cache and sessions
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Sync queue (no external queue needed)
QUEUE_CONNECTION=sync

# File-based broadcasting
BROADCAST_CONNECTION=log

# Local filesystem
FILESYSTEM_DISK=local

# Simple logging
LOG_CHANNEL=single
LOG_LEVEL=error

# Mail (optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Filament
FILAMENT_DOMAIN=your-domain.com
FILAMENT_PATH=admin