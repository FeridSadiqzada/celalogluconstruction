# Ultra simple Dockerfile with SQLite only
FROM php:8.3-fpm-alpine

# Install minimal dependencies
RUN apk add --no-cache \
    bash \
    nginx \
    supervisor \
    sqlite \
    libpng-dev \
    libzip-dev \
    zip \
    unzip

# Install PHP extensions (SQLite only)
RUN docker-php-ext-install pdo_sqlite zip gd opcache

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html

# Copy application
COPY . .

# Create .env file from SQLite template
RUN cp .env.sqlite .env || cp .env.example .env

# Install dependencies
RUN composer install --no-dev --optimize-autoloader

# Create SQLite database
RUN touch database/database.sqlite \
    && chown www-data:www-data database/database.sqlite

# Basic PHP configuration
RUN echo 'memory_limit = 256M' > /usr/local/etc/php/conf.d/memory.ini \
    && echo 'upload_max_filesize = 32M' >> /usr/local/etc/php/conf.d/memory.ini \
    && echo 'post_max_size = 32M' >> /usr/local/etc/php/conf.d/memory.ini \
    && echo 'opcache.enable = 1' > /usr/local/etc/php/conf.d/opcache.ini \
    && echo 'opcache.memory_consumption = 128' >> /usr/local/etc/php/conf.d/opcache.ini

# Basic nginx config
RUN echo 'server { \
    listen 80; \
    root /var/www/html/public; \
    index index.php; \
    location / { try_files $uri $uri/ /index.php?$query_string; } \
    location ~ \.php$ { \
        fastcgi_pass 127.0.0.1:9000; \
        fastcgi_index index.php; \
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; \
        include fastcgi_params; \
    } \
}' > /etc/nginx/http.d/default.conf

# Basic supervisor config
RUN echo '[supervisord] \
nodaemon=true \
[program:nginx] \
command=nginx -g "daemon off;" \
autostart=true \
autorestart=true \
[program:php-fpm] \
command=php-fpm -F \
autostart=true \
autorestart=true' > /etc/supervisor/conf.d/supervisord.conf

# Set permissions
RUN chown -R www-data:www-data storage bootstrap/cache database \
    && chmod -R 775 storage bootstrap/cache database

# Copy startup script
COPY docker/startup.sh /usr/local/bin/startup.sh
RUN chmod +x /usr/local/bin/startup.sh

# Expose port
EXPOSE 80

# Start with startup script
CMD ["/usr/local/bin/startup.sh"]