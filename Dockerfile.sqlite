# Ultra simple Dockerfile with SQLite only
FROM php:8.3-fpm-alpine

# Install minimal dependencies
RUN apk add --no-cache \
    bash \
    nginx \
    supervisor \
    sqlite \
    libpng-dev \
    libzip-dev \
    zip \
    unzip

# Install PHP extensions (SQLite only)
RUN docker-php-ext-install pdo_sqlite zip gd opcache

# Configure PHP-FPM
RUN echo 'listen = 127.0.0.1:9000' > /usr/local/etc/php-fpm.d/www.conf \
    && echo 'user = www-data' >> /usr/local/etc/php-fpm.d/www.conf \
    && echo 'group = www-data' >> /usr/local/etc/php-fpm.d/www.conf \
    && echo 'pm = dynamic' >> /usr/local/etc/php-fpm.d/www.conf \
    && echo 'pm.max_children = 5' >> /usr/local/etc/php-fpm.d/www.conf \
    && echo 'pm.start_servers = 2' >> /usr/local/etc/php-fpm.d/www.conf \
    && echo 'pm.min_spare_servers = 1' >> /usr/local/etc/php-fpm.d/www.conf \
    && echo 'pm.max_spare_servers = 3' >> /usr/local/etc/php-fpm.d/www.conf

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html

# Copy application
COPY . .

# Create .env file from SQLite template
RUN cp .env.sqlite .env || cp .env.example .env

# Install dependencies
RUN composer install --no-dev --optimize-autoloader

# Create SQLite database
RUN touch database/database.sqlite \
    && chown www-data:www-data database/database.sqlite

# Basic PHP configuration
RUN echo 'memory_limit = 256M' > /usr/local/etc/php/conf.d/memory.ini \
    && echo 'upload_max_filesize = 32M' >> /usr/local/etc/php/conf.d/memory.ini \
    && echo 'post_max_size = 32M' >> /usr/local/etc/php/conf.d/memory.ini \
    && echo 'opcache.enable = 1' > /usr/local/etc/php/conf.d/opcache.ini \
    && echo 'opcache.memory_consumption = 128' >> /usr/local/etc/php/conf.d/opcache.ini

# Detailed nginx config for Laravel (Port 5555)
RUN echo 'server { \
    listen 5555; \
    server_name _; \
    root /var/www/html/public; \
    index index.php index.html; \
    \
    location / { \
        try_files $uri $uri/ /index.php?$query_string; \
    } \
    \
    location ~ \.php$ { \
        include fastcgi_params; \
        fastcgi_pass 127.0.0.1:9000; \
        fastcgi_index index.php; \
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name; \
        fastcgi_param PATH_INFO $fastcgi_path_info; \
        fastcgi_read_timeout 300; \
    } \
    \
    location ~ /\. { \
        deny all; \
    } \
}' > /etc/nginx/http.d/default.conf

# Create supervisor log directory and copy simple config
RUN mkdir -p /var/log/supervisor \
    && chown -R www-data:www-data /var/log/supervisor
COPY docker/supervisor/supervisord-simple.conf /etc/supervisor/conf.d/supervisord.conf

# Set permissions
RUN chown -R www-data:www-data storage bootstrap/cache database \
    && chmod -R 775 storage bootstrap/cache database

# Copy startup script
COPY docker/startup.sh /usr/local/bin/startup.sh
RUN chmod +x /usr/local/bin/startup.sh

# Expose port
EXPOSE 5555

# Start with startup script
CMD ["/usr/local/bin/startup.sh"]